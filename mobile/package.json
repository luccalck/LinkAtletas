{
  "name": "linkatletas-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform android --platform ios",
    "check": "node scripts/check-dependencies.cjs",
    "check:updates": "expo install --check",
    "test": "vitest run"
  },
  "dependencies": {
    "expo": "57.0.30",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.23",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "2.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "react-test-renderer": "19.2.3",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "xcode>uuid": "11.1.1",
      "node-forge": "1.4.2",
      "@expo/cli>zod": "4.6.6"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
