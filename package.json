{
  "name": "linkatletas",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev\"",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx server/index.ts",
    "api:export": "tsx scripts/documentacao/export-openapi.ts",
    "db:admin": "tsx server/db/admin.ts",
    "test:smoke": "tsx scripts/verificacao/smoke-server.ts",
    "jobs": "tsx server/jobs.ts",
    "docs:check": "tsx scripts/documentacao/check-docs.ts",
    "test:load": "tsx scripts/verificacao/load-matching.ts",
    "test:tls": "tsx scripts/verificacao/verify-tls.ts",
    "test:backup": "tsx scripts/verificacao/verify-backup.ts",
    "production:init": "tsx scripts/operacao/init-production.ts",
    "mobile:connect": "tsx scripts/android/connect-android.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@fastify/websocket": "11.3.4",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "lucide-react": "1.31.0",
    "nodemailer": "10.1.4",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tsx": "4.23.15",
    "vite": "8.2.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.2",
    "concurrently": "9.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "@fastify/static>content-disposition": "2.0.1",
      "fast-uri@>=3 <4": "3.1.9",
      "fast-uri@>=4 <5": "4.2.3"
    }
  }
}
